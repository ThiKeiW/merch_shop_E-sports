# Copia este archivo como .env y ajusta los valores para tu entorno local.
# .env NO se versiona (ver .gitignore).

# --- MySQL ---
DB_NAME=merch_shop
DB_USER=merch
DB_PASSWORD=merchpass
DB_ROOT_PASSWORD=rootpass
# Puerto del host para conectarse a MySQL (el contenedor siempre escucha en 3306)
DB_PORT=3307

# --- Backend ---
BACKEND_PORT=8080
DB_POOL_SIZE=20
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Secreto JWT (se usa a partir de la Fase 2; usar 32+ caracteres aleatorios)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- Frontend ---
FRONTEND_PORT=5173

# --- Stripe (Fase 6) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
