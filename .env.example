# Copia este archivo como .env y ajusta los valores para tu entorno local.
# .env NO se versiona (ver .gitignore).

# --- MySQL ---
DB_NAME=merch_shop
DB_USER=merch
DB_PASSWORD=merchpass
DB_ROOT_PASSWORD=rootpass
# Puerto del host para conectarse a MySQL (el contenedor siempre escucha en 3306)
DB_PORT=3307

# --- Backend ---
BACKEND_PORT=8080
DB_POOL_SIZE=20
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Secreto JWT (minimo 32 caracteres aleatorios); JWT_TTL en formato ISO-8601
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_TTL=PT24H

# --- Google OAuth (opcional) ---
# Client ID OAuth 2.0 (tipo "Web") creado en Google Cloud Console.
# Si queda vacío, /api/auth/google responde 503 y el botón no aparece.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- Frontend ---
FRONTEND_PORT=5173

# --- Stripe (Fase 6) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
